<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Nexus - Home</title>
  <link rel="stylesheet" href="style.css"> 
</head>
<body>

  <canvas id="particleCanvas"></canvas>

  <div class="container">
    
    <div id="auth">
      <div class="auth-box" style="text-align: center; max-width: 400px; margin: 0 auto;">
        <h2 style="margin-bottom: 20px;">Nexus Login</h2>
        <input type="email" id="email" placeholder="Email" style="width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 5px; border: 1px solid #ddd; display:block;">
        <input type="password" id="password" placeholder="Password" style="width: 100%; padding: 10px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #ddd; display:block;">
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button class="primary" onclick="login()">Login</button>
            <button class="secondary" onclick="register()">Register</button>
        </div>
      </div>
    </div>
    
    <div id="content" style="display: none;">
      
      <div id="welcomeWizard" class="auth-box wizard-container">
        
        <div class="wizard-slide active">
            <span class="slide-icon">👋</span>
            <div class="slide-content">
                <h2>Welcome to Nexus</h2>
                <p>You have successfully connected to the system. Before you begin your journey, please review the protocols.</p>
                <p>Nexus is a unified platform for communication, research, and gaming.</p>
            </div>
        </div>

        <div class="wizard-slide">
            <span class="slide-icon">⚖️</span>
            <div class="slide-content">
                <h2>System Protocols (Rules)</h2>
                <ul>
                    <li><strong>Respect:</strong> Treat all users with courtesy. Harassment is grounds for immediate termination.</li>
                    <li><strong>Security:</strong> Do not share your password or personal data in public channels.</li>
                    <li><strong>Content:</strong> No spamming, NSFW content, or illegal materials.</li>
                </ul>
            </div>
        </div>

        <div class="wizard-slide">
            <span class="slide-icon">🧭</span>
            <div class="slide-content">
                <h2>Navigation Instructions</h2>
                <p>Use the sidebar (top left menu) to access different modules:</p>
                <ul>
                    <li><strong>💬 Chat:</strong> Global real-time messaging.</li>
                    <li><strong>📞 Video Call:</strong> How to call people on Nexus, first, check if people are online if it says unidentified there not online, next, person 1 calls person 2 after pick and then hang up and vise versa, after, call eachother then kaboom.</li>
                    <li><strong>🌐 Research(proxy):</strong> How to ddos, ddosing is breaking through the wall, basically spam esc when first loaded in, then, put a word into the search bar after, let it get blocked finally, click back arrown on your screen.</li>
                    <li><strong>⚙️ Settings:</strong> Customize your theme and profile.</li>
                </ul>
            </div>
        </div>

        <div class="wizard-slide">
            <span class="slide-icon">🚀</span>
            <div class="slide-content">
                <h2>Systems Ready</h2>
                <p>Your profile has been loaded. You are now ready to access the dashboard.</p>
                <p>Click "Enter Nexus" to begin.</p>
            </div>
        </div>

        <div class="wizard-nav">
            <button class="secondary" id="prevBtn" onclick="changeSlide(-1)" style="visibility: hidden;">Back</button>
            <div class="wizard-dots">
                <span class="dot active"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
            <button class="primary" id="nextBtn" onclick="changeSlide(1)">Next</button>
        </div>
      </div>

      <div id="mainDashboard">
        <div class="auth-box">
            <h2>Dashboard</h2>
            <p>Welcome back, <span id="dashName">User</span>.</p>
            <p style="margin-bottom:20px; font-size: 0.9em; opacity: 0.7;">Select a module to begin.</p>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                <button class="secondary" onclick="window.location.href='chat.html'" style="height: 100px; font-size: 16px;">
                    💬<br>Open Chat
                </button>
                <button class="secondary" onclick="window.location.href='games.html'" style="height: 100px; font-size: 16px;">
                    🎮<br>Play Games
                </button>
                <button class="secondary" onclick="window.location.href='call.html'" style="height: 100px; font-size: 16px;">
                    📞<br>Video Call
                </button>
                <button class="secondary" onclick="window.location.href='research.html'" style="height: 100px; font-size: 16px;">
                    🌐<br>Research Portal
                </button>
                <button class="secondary" onclick="window.location.href='settings.html'" style="height: 100px; font-size: 16px;">
                    ⚙️<br>Settings
                </button>
            </div>
        </div>
      </div>

    </div>
  </div>

  <script src="global.js"></script> 
  <script type="module" src="auth.js"></script> 
  <script src="particles.js"></script> 

  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.wizard-slide');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const wizardBox = document.getElementById('welcomeWizard');
    const dashboard = document.getElementById('mainDashboard');

    // Sync name to dashboard (auth.js updates localStorage)
    function updateDashName() {
        const storedName = localStorage.getItem('userName');
        const dashNameSpan = document.getElementById('dashName');
        if(storedName && dashNameSpan) dashNameSpan.textContent = storedName;
    }
    // Check for name update every second
    setInterval(updateDashName, 1000);

    function showSlide(n) {
        // Hide all
        slides.forEach(slide => slide.classList.remove('active'));
        dots.forEach(dot => dot.classList.remove('active'));

        // Show current
        slides[n].classList.add('active');
        dots[n].classList.add('active');

        // Button Visibility Logic
        if (n === 0) {
            prevBtn.style.visibility = 'hidden';
        } else {
            prevBtn.style.visibility = 'visible';
        }

        // Change "Next" to "Enter" on last slide
        if (n === slides.length - 1) {
            nextBtn.textContent = 'Enter Nexus';
            nextBtn.onclick = finishWizard;
        } else {
            nextBtn.textContent = 'Next';
            nextBtn.onclick = () => changeSlide(1);
        }
    }

    function changeSlide(n) {
        currentSlide += n;
        // Boundary checks
        if (currentSlide >= slides.length) currentSlide = slides.length - 1;
        if (currentSlide < 0) currentSlide = 0;
        showSlide(currentSlide);
    }

    function finishWizard() {
        // Hide Wizard, Show Dashboard
        wizardBox.style.display = 'none';
        dashboard.style.display = 'block';
    }

    // Initialize slide 0
    showSlide(0);
  </script>
</body>
</html>
